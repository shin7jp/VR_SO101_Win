# コピーして .env にしても、PowerShell で $env:NAME=... でも良い (アプリは .env を自動では読まない)
VRSO101_BACKEND=gazebo            # gazebo | mock (mock は疑似シム。検証結果にはならない)
VRSO101_DATA_DIR=E:\claude\VR_SO101_ACT_Win_Web\data
VRSO101_BRIDGE_PORT=9100          # WSL の Gazebo ブリッジ
# VRSO101_TOKEN=change-me         # LAN に公開するとき。設定すると変更系 API / WebSocket にトークンが必要
# VRSO101_STEP_TIMEOUT=30         # ブリッジ内の観測待ち上限 [秒]
HF_HUB_OFFLINE=1                  # 学習ジョブは既定でこれを付けて起動する (外部送信なし)
# VRSO101_BRIDGE_HOST=localhost   # WSL ブリッジの接続先 (既定 localhost)
# VRSO101_E2E=1                   # 実 Gazebo + 実 ACT の E2E テストを実行する (pytest tests/test_e2e_gazebo.py)
# --- モデル生成時だけ (sim/tools/build_model.py, decimate_visuals.py) ---
# VRSO101_JAW_HULLS=8             # 把持面の凸分解の最大個数
# VRSO101_HULL_VERTS=96           # 衝突用凸包 1 個あたりの最大頂点数
# VRSO101_DECIMATE_TOL_MM=0.5     # Web 3D 表示用 STL の軽量化で許す外郭のずれ [mm]
